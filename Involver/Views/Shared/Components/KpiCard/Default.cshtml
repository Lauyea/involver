@using Involver.Models.ViewModels.Dashboard
@model KpiCardViewModel
@{
    var change = Model.ChangePercent;
    var changeModifier = change switch
    {
        > 0 => "up",
        < 0 => "down",
        _ => "flat",
    };
    var changeIcon = change switch
    {
        > 0 => "fa-arrow-up",
        < 0 => "fa-arrow-down",
        _ => "fa-minus",
    };
}

<div class="dashboard__card kpi-card h-100 p-3 position-relative">
    <div class="d-flex justify-content-between align-items-start gap-2">
        <div class="kpi-card__label">
            @if (!string.IsNullOrEmpty(Model.LabelTooltip))
            {
                <abbr class="abbr-tooltip" tabindex="0" data-bs-toggle="tooltip" data-bs-title="@Model.LabelTooltip">@Model.Label</abbr>
            }
            else
            {
                @Model.Label
            }
        </div>
        @if (!string.IsNullOrEmpty(Model.Icon))
        {
            <i class="fa-solid @Model.Icon text-body-secondary" aria-hidden="true"></i>
        }
    </div>
    <div class="kpi-card__value @(Model.IsCore ? "kpi-card__value--core" : string.Empty)">
        @Model.Value.ToString(Model.Format)@if (!string.IsNullOrEmpty(Model.Suffix))
        {
            <small class="fs-6 fw-normal ms-1">@Model.Suffix</small>
        }
    </div>
    @if (Model.ComparisonLabel != null)
    {
        <div class="kpi-card__change kpi-card__change--@changeModifier" title="@Model.ComparisonLabel">
            @if (change.HasValue)
            {
                <i class="fa-solid @changeIcon" aria-hidden="true"></i>
                @($"{Math.Abs(change.Value):0.#}%")
                <span class="text-body-secondary">@Model.ComparisonLabel</span>
            }
            else
            {
                <span class="text-body-secondary">— 尚無可比較的資料</span>
            }
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Hint))
    {
        <div class="small text-body-secondary mt-1">@Model.Hint</div>
    }
    @if (Model.Target != null)
    {
        <div class="mt-2">
            <div class="d-flex justify-content-between small text-body-secondary">
                <span>@Model.Target.PeriodLabel 目標 @Model.Target.TargetValue.ToString("N0")</span>
                <span>@Model.Target.Percent.ToString("0")%</span>
            </div>
            <div class="progress kpi-card__progress" role="progressbar"
                 aria-label="@Model.Label 目標達成率"
                 aria-valuenow="@Math.Min(Model.Target.Percent, 100).ToString("0")" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @Math.Min(Model.Target.Percent, 100).ToString("0")%"></div>
            </div>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.Url))
    {
        <a href="@Model.Url" class="stretched-link" aria-label="@Model.Label"></a>
    }
</div>
