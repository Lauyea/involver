@page
@model Involver.Areas.Admin.Pages.Payments.IndexModel
@{
    // 沒有用戶管理權限時，用戶名不加連結（點了會 403）
    var canViewUsers = (await AuthorizationService.AuthorizeAsync(User, AdminPolicies.Users)).Succeeded;
    ViewData["Title"] = "訂單";
}

<div class="row row-cols-1 row-cols-md-3 g-3 mb-3">
    @foreach (var card in Model.Cards)
    {
        <div class="col">@await Component.InvokeAsync("KpiCard", new { card })</div>
    }
</div>

<form method="get" class="dashboard__card p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-6 col-md-3">
            <label asp-for="From" class="form-label small">開始日期</label>
            <input asp-for="From" type="date" class="form-control" />
        </div>
        <div class="col-6 col-md-3">
            <label asp-for="To" class="form-label small">結束日期</label>
            <input asp-for="To" type="date" class="form-control" />
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label small">付款狀態</label>
            <select asp-for="Status" class="form-select">
                <option value="All">全部</option>
                <option value="Succeeded">成功</option>
                <option value="Failed">失敗</option>
                <option value="Simulated">模擬付款</option>
                <option value="Voided">已作廢</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1"><i class="fa-solid fa-filter me-1"></i>篩選</button>
            @* GET 表單會丟掉 action 的查詢字串，所以匯出用連結帶上目前套用的條件 *@
            <a class="btn btn-outline-secondary" title="依目前套用的條件匯出 CSV"
               href="@Url.Page("./Index", "Export", new { Model.From, Model.To, Model.Status })">
                <i class="fa-solid fa-file-csv"></i><span class="visually-hidden">匯出 CSV</span>
            </a>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="small text-body-secondary">共 @Model.TotalCount.ToString("N0") 筆</span>
    <partial name="_Pager" model="(Model.PageIndex, Model.TotalPages)" />
</div>

<div class="dashboard__card table-responsive">
    <table class="table table-hover align-middle mb-0 dashboard__table">
        <thead>
            <tr>
                <th scope="col">付款時間</th>
                <th scope="col">用戶</th>
                <th scope="col">特店交易編號</th>
                <th scope="col">綠界交易編號</th>
                <th scope="col" class="text-end">金額</th>
                <th scope="col">狀態</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var payment in Model.Payments)
            {
                <tr>
                    <td class="text-nowrap">@(payment.Time?.ToString("yyyy/MM/dd HH:mm") ?? payment.RawTime)</td>
                    <td>
                        @if (payment.UserId != null)
                        {
                            if (canViewUsers)
                            {
                                <a asp-page="/Users/Details" asp-route-id="@payment.UserId">@(payment.UserName ?? "（找不到用戶）")</a>
                            }
                            else
                            {
                                @(payment.UserName ?? "（找不到用戶）")
                            }
                        }
                    </td>
                    <td><a asp-page="./Details" asp-route-id="@payment.PaymentId"><code>@payment.MerchantTradeNo</code></a></td>
                    <td><code>@payment.TradeNo</code></td>
                    <td class="text-end">@payment.Amount.ToString("N0")</td>
                    <td><span class="badge @IndexModel.StatusBadge(payment)" title="@payment.RtnMsg">@IndexModel.StatusText(payment)</span></td>
                </tr>
            }
            @if (Model.Payments.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-body-secondary py-4">沒有符合條件的訂單</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="d-flex justify-content-end mt-2">
    <partial name="_Pager" model="(Model.PageIndex, Model.TotalPages)" />
</div>
