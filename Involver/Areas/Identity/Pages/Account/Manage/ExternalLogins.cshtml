@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = "外部登入";
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<partial name="_StatusMessage" for="StatusMessage" />

<section class="account-section" aria-labelledby="current-logins-heading">
    <h2 id="current-logins-heading" class="account-section__title">已連結的帳號</h2>
    @if (Model.CurrentLogins?.Count > 0)
    {
        <ul class="account-list">
            @foreach (var login in Model.CurrentLogins)
            {
                <li class="account-list__item">
                    <span class="account-list__label">@login.ProviderDisplayName</span>
                    @if (Model.ShowRemoveButton)
                    {
                        <form asp-page-handler="RemoveLogin" method="post">
                            <input asp-for="@login.LoginProvider" name="LoginProvider" type="hidden" />
                            <input asp-for="@login.ProviderKey" name="ProviderKey" type="hidden" />
                            <button type="submit" class="btn btn-outline-danger">移除 @login.ProviderDisplayName</button>
                        </form>
                    }
                </li>
            }
        </ul>
        @if (!Model.ShowRemoveButton)
        {
            <p class="form-text mb-0">這是你唯一的登入方式，要先<a asp-page="./SetPassword">設定密碼</a>才能移除。</p>
        }
    }
    else
    {
        <p class="text-body-secondary mb-0">還沒有連結外部帳號。</p>
    }
</section>

@if (Model.OtherLogins?.Count > 0)
{
    <section class="account-section" aria-labelledby="add-login-heading">
        <h2 id="add-login-heading" class="account-section__title">連結其他帳號</h2>
        <form id="link-login-form" asp-page-handler="LinkLogin" method="post" class="d-flex flex-wrap gap-2">
            @foreach (var provider in Model.OtherLogins)
            {
                <button type="submit" class="btn btn-outline-primary" name="provider" value="@provider.Name">連結 @provider.DisplayName</button>
            }
        </form>
    </section>
}
