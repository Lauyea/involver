@inject SignInManager<InvolverUser> SignInManager
@*
    帳號管理的導覽（Material navigation list）。寬螢幕是分組的直排清單，手機是可以橫向捲動的一列。
*@
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var activePage = ManageNavPages.GetActivePage(ViewContext);
}

<nav class="account-nav" aria-label="帳號管理">
    @foreach (var (group, index) in ManageNavPages.Groups(hasExternalLogins).Select((g, i) => (g, i)))
    {
        var headingId = $"account-nav-group-{index}";
        <div class="account-nav__group">
            <p id="@headingId" class="account-nav__heading">@group.Title</p>
            <ul class="account-nav__list" aria-labelledby="@headingId">
                @foreach (var item in group.Items)
                {
                    var isActive = string.Equals(item.Key, activePage, StringComparison.OrdinalIgnoreCase);
                    <li>
                        <a class="account-nav__item @(isActive ? "account-nav__item--active" : null)"
                           asp-page="@item.Page"
                           aria-current="@(isActive ? "page" : null)">
                            <i class="fas @item.Icon account-nav__icon" aria-hidden="true"></i>
                            <span>@item.Label</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
</nav>
