@page
@model PersonalDataModel
@{
    ViewData["Title"] = "下載與刪除資料";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<section class="account-section" aria-labelledby="download-heading">
    <h2 id="download-heading" class="account-section__title">下載你的資料</h2>
    <p>把帳號裡的個人資料下載成一個 JSON 檔案。</p>
    <form id="download-data" asp-page="DownloadPersonalData" method="post" class="needs-recaptcha" data-sitekey="@Configuration["reCAPTCHA_SiteKey"]" data-action="DownloadPersonalData">
        <button class="btn btn-outline-primary" type="submit"><i class="fas fa-download me-1" aria-hidden="true"></i>下載</button>
    </form>
</section>

<section class="account-section account-section--danger" aria-labelledby="delete-heading">
    <h2 id="delete-heading" class="account-section__title">刪除帳號</h2>
    <p>刪除後帳號會永久停用，而且不能恢復。下一步會說明哪些資料會被清除、哪些會保留。</p>
    <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger">刪除帳號…</a>
</section>
