@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "刪除帳號";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="alert alert-warning" role="alert">
    <p>
        <strong>刪除後帳號會永久停用，無法再登入，而且不能恢復。</strong>
    </p>
    <p>
        <strong>你的 Email、手機號碼、外部登入、自我介紹、頭像、通知與瀏覽紀錄會被清除。</strong>
    </p>
    <p>
        你發表的作品、留言與 In 幣交易紀錄會保留，作者名稱改為匿名的「deleted-」開頭用戶名。
    </p>
</div>

<div>
    <form id="delete-user" method="post" class="account-form mb-3 needs-recaptcha" data-sitekey="@Configuration["reCAPTCHA_SiteKey"]" data-action="DeletePersonalData">
        <div asp-validation-summary="All" class="text-danger"></div>
        @if (Model.RequirePassword)
        {
            <div class="mb-3">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        }
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-danger" type="submit">刪除並關閉帳號</button>
            <a class="btn btn-outline-secondary" asp-page="./PersonalData">取消</a>
        </div>
    </form>
</div>

@section Scripts {
}