@page
@model IndexModel
@{
    ViewData["Title"] = "帳號資料";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<partial name="_StatusMessage" model="Model.StatusMessage" />

<form id="profile-form" method="post" class="account-form needs-recaptcha" data-sitekey="@Configuration["reCAPTCHA_SiteKey"]" data-action="UpdateProfile">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <section class="account-section">
        <div class="mb-3">
            <label asp-for="Input.UserName" class="form-label"></label>
            @if (Model.Profile.CanChangeUserName)
            {
                <input asp-for="Input.UserName" class="form-control" aria-describedby="username-help" />
                <div id="username-help" class="form-text">用戶名只能變更一次，會顯示在你的作品與留言上。</div>
            }
            else
            {
                <input asp-for="Input.UserName" class="form-control" disabled aria-describedby="username-help" />
                <div id="username-help" class="form-text">你已經變更過用戶名，無法再次變更。</div>
            }
            <span asp-validation-for="Input.UserName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.PhoneNumber" class="form-label"></label>
            <input asp-for="Input.PhoneNumber" class="form-control" type="tel" autocomplete="tel" aria-describedby="phone-help" />
            <div id="phone-help" class="form-text">不會公開。</div>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
        </div>
    </section>
    <button id="update-profile-button" type="submit" class="btn btn-primary">儲存</button>
</form>

@section Scripts {
    <script src="https://www.google.com/recaptcha/api.js?render=@Configuration["reCAPTCHA_SiteKey"]" async defer></script>
}
