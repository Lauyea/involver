@model IEnumerable<Involver.Models.ViewModels.FollowedNovelViewModel>

@foreach (var follow in Model)
{
    <div class="row">
        <div class="col-md-5">
            <a asp-page="/Episodes/Details" 
               asp-route-id="@follow.LatestEpisodeID">
            @follow.LatestEpisodeTitle</a>
        </div>
        <div class="col-md-4">
            <a asp-page="/Novels/Details" asp-route-id="@follow.NovelID">@follow.NovelTitle</a>
            @if (follow.NovelMonthlyInvolver)
            {
                <div class="btn btn-xs btn-outline-danger disabled">Involve</div>
            }
        </div>
        <div class="col-md-3">
            <p>
                <a asp-page="./Index"
                   asp-route-id="@follow.AuthorID">
                <small>@follow.AuthorUserName</small></a>
            </p>
            <small title="@follow.NovelUpdateTime">@Involver.Helpers.TimePeriodHelper.Get(follow.NovelUpdateTime)</small>
        </div>
    </div>
    <hr />
}
