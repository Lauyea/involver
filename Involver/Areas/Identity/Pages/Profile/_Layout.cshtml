@{
    Layout = "/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/feed.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
}

<div class="profile">
    @await Component.InvokeAsync("ProfileHeader", new
    {
        profileId = ManageNavPages.GetProfileID(ViewContext),
        activeTab = ManageNavPages.GetActivePage(ViewContext),
    })
    <partial name="_ProfileSubNavPartial" />
    <div class="profile__content">
        @RenderBody()
    </div>
</div>

@section Scripts {
    <script src="~/js/social-actions.js" asp-append-version="true"></script>
    <script>
      // 手機上分頁標籤會橫向捲動，把目前的分頁捲進畫面
      document.querySelector('.profile-tabs [aria-current="page"]')?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    </script>
    @RenderSection("Scripts", required: false)
}
