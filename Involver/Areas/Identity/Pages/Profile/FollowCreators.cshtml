@page
@model Involver.Areas.Identity.Pages.Profile.FollowCreatorsModel
@{
    ViewData["Title"] = "追蹤";
    ViewData["ActivePage"] = ManageNavPages.Follow;
    ViewData["ProfileID"] = Model.Profile.ProfileID;
}

<div>
    <div id="creators-container">
        <partial name="_FollowCreatorListPartial" model="Model.Creators" />
    </div>
    <div id="loading" style="display: none;" class="text-center">
        <p>正在加載更多...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var profileId = "@Model.Profile.ProfileID";
            setupInfiniteScroll('#creators-container', '#loading', 'LoadMore', { id: profileId });
        });
    </script>
}