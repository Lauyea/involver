@page
@model Involver.Areas.Identity.Pages.Profile.FollowArticlesModel
@{
    ViewData["Title"] = "追蹤";
    ViewData["ActivePage"] = ManageNavPages.Follow;
    ViewData["ProfileID"] = Model.Profile.ProfileID;
}

<div>
    <div id="articles-container">
        <partial name="_FollowArticleListPartial" model="Model.Articles" />
    </div>
    <div id="loading" style="display: none;" class="text-center">
        <p>正在加載更多...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var profileId = "@Model.Profile.ProfileID";
            setupInfiniteScroll('#articles-container', '#loading', 'LoadMore', { id: profileId });
        });
    </script>
}