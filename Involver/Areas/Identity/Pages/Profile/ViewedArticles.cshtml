@page
@model Involver.Areas.Identity.Pages.Profile.ViewedArticlesModel
@{
    ViewData["Title"] = "觀看紀錄";
    ViewData["ActivePage"] = ManageNavPages.Bookshelf;
    ViewData["ProfileID"] = Model.Profile.ProfileID;
}

<div>
    <div id="viewed-articles-container">
        <partial name="_ViewedArticleListPartial" model="Model.Articles" />
    </div>
    <div id="loading" style="display: none;" class="text-center">
        <p>正在加載更多...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var profileId = "@Model.Profile.ProfileID";
            setupInfiniteScroll('#viewed-articles-container', '#loading', 'LoadMore', { id: profileId });
        });
    </script>
}