@page
@model Involver.Areas.Identity.Pages.Profile.AgreesModel
@{
    ViewData["Title"] = "互動紀錄";
    ViewData["ActivePage"] = ManageNavPages.Interaction;
    ViewData["ProfileID"] = Model.Profile.ProfileID;
}

<div>
    <div id="agrees-container">
        <partial name="_AgreeListPartial" model="Model.Agrees" />
    </div>
    <div id="loading" style="display: none;" class="text-center">
        <p>正在加載更多...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var profileId = "@Model.Profile.ProfileID";
            setupInfiniteScroll('#agrees-container', '#loading', 'LoadMore', { id: profileId });
        });
    </script>
}