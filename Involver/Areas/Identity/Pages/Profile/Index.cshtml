@page
@model Involver.Areas.Identity.Pages.Profile.IndexModel
@{
    ViewData["Title"] = $"{Model.Profile.UserName} 的個人檔案";
    ViewData["ActivePage"] = ManageNavPages.Index;
    ViewData["ProfileID"] = Model.Profile.ProfileID;
}

<partial name="_StatusMessage" model="Model.StatusMessage" />

<div class="profile-overview">
    <div class="profile-overview__main">
        @if (Model.ProfileOwner)
        {
            <section aria-labelledby="continue-heading">
                <div class="feed-section__header">
                    <h2 id="continue-heading" class="feed-section__title"><i class="fas fa-book-open" aria-hidden="true"></i>繼續閱讀</h2>
                    <a class="feed-section__more" asp-page="./Bookshelf" asp-route-id="@Model.Profile.ProfileID">前往書房</a>
                </div>
                @if (Model.ContinueReading.Count > 0)
                {
                    <div class="feed-scroller">
                        @foreach (var item in Model.ContinueReading)
                        {
                            <div class="feed-scroller__item"><partial name="_ContentCardPartial" model="item.Card" /></div>
                        }
                    </div>
                }
                else
                {
                    <p class="feed-section__empty">
                        @(Model.HasBookshelf ? "追蹤的作品都讀完了，或還沒開始讀。" : "追蹤喜歡的作品，就能在這裡接著上次的進度讀。")
                        <a asp-page="./Bookshelf" asp-route-id="@Model.Profile.ProfileID">打開書架</a>
                    </p>
                }
            </section>
        }

        <section aria-labelledby="works-heading">
            <div class="feed-section__header">
                <h2 id="works-heading" class="feed-section__title"><i class="fas fa-pen-nib" aria-hidden="true"></i>最新作品</h2>
                @if (Model.LatestWorks.Count > 0)
                {
                    <a class="feed-section__more" asp-page="./Creations" asp-route-id="@Model.Profile.ProfileID">全部作品</a>
                }
            </div>
            @if (Model.LatestWorks.Count > 0)
            {
                <div class="feed-grid">
                    @foreach (var card in Model.LatestWorks)
                    {
                        <partial name="_ContentCardPartial" model="card" />
                    }
                </div>
            }
            else if (Model.ProfileOwner)
            {
                <p class="feed-section__empty">
                    還沒有發表作品。<a asp-area="" asp-page="/Novels/Create">開始創作</a>
                </p>
            }
            else
            {
                <p class="feed-section__empty">@Model.Profile.UserName 還沒有發表作品。</p>
            }
        </section>
    </div>

    <aside class="profile-overview__side">
        <section class="profile-card" aria-labelledby="about-heading">
            <h2 id="about-heading" class="profile-card__title">關於</h2>
            @if (!string.IsNullOrWhiteSpace(Model.Profile.Introduction))
            {
                <div class="profile-card__intro">@Html.AntiXssRaw(Model.Profile.Introduction.Replace("\r\n", "<br />"))</div>
            }
            else if (Model.ProfileOwner)
            {
                <p class="profile-card__intro text-body-secondary">
                    還沒有自我介紹。<a asp-page="./ChangeProfile" asp-route-id="@Model.Profile.ProfileID">寫一段介紹</a>
                </p>
            }
            <dl class="profile-card__facts">
                <div>
                    <dt><i class="far fa-calendar-alt" aria-hidden="true"></i>加入</dt>
                    <dd>@Model.Profile.EnrollmentDate.ToString("yyyy/MM/dd")</dd>
                </div>
                <div>
                    <dt><i class="far fa-clock" aria-hidden="true"></i>最近上線</dt>
                    <dd title="@Model.Profile.LastTimeLogin">@TimePeriodHelper.Get(Model.Profile.LastTimeLogin)</dd>
                </div>
                <div>
                    <dt><i class="far fa-eye" aria-hidden="true"></i>個人檔案瀏覽</dt>
                    <dd>@Model.Profile.Views.ToString("N0")</dd>
                </div>
                <div>
                    <dt><i class="fas fa-trophy" aria-hidden="true"></i>成就</dt>
                    <dd><a asp-page="./Achievements" asp-route-id="@Model.Profile.ProfileID">@Model.AchievementCount 個</a></dd>
                </div>
            </dl>
        </section>

        @if (Model.ProfileOwner)
        {
            <section class="profile-card" aria-labelledby="mine-heading">
                <h2 id="mine-heading" class="profile-card__title">只有你看得到</h2>
                <ul class="profile-links">
                    <li>
                        <a class="profile-links__item" asp-page="./Missions" asp-route-id="@Model.Profile.ProfileID">
                            <i class="fas fa-list-check" aria-hidden="true"></i>
                            <span>每週任務</span>
                            <span class="profile-links__meta">@Model.MissionsDone／@IndexModel.MissionCount</span>
                        </a>
                    </li>
                    <li>
                        <a class="profile-links__item" asp-page="/Account/Manage/Wallet">
                            <i class="fas fa-wallet" aria-hidden="true"></i>
                            <span>錢包與會員</span>
                            <span class="profile-links__meta">@((Model.Profile.VirtualCoins + Model.Profile.RealCoins).ToString("N0")) In</span>
                        </a>
                    </li>
                    <li>
                        <a class="profile-links__item" asp-area="" asp-page="/Creator/Index">
                            <i class="fas fa-chart-line" aria-hidden="true"></i>
                            <span>創作者中心</span>
                        </a>
                    </li>
                    <li>
                        <a class="profile-links__item" asp-page="/Account/Manage/Index">
                            <i class="fas fa-gear" aria-hidden="true"></i>
                            <span>帳號管理</span>
                            @if (Model.Profile.CanChangeUserName)
                            {
                                <span class="profile-links__meta">可變更用戶名一次</span>
                            }
                        </a>
                    </li>
                </ul>
            </section>
        }
    </aside>
</div>
