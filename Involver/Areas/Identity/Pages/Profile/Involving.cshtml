@page
@model Involver.Areas.Identity.Pages.Profile.InvolvingModel
@{
    ViewData["Title"] = "Involving";
    ViewData["ActivePage"] = ManageNavPages.Involving;
    ViewData["ProfileID"] = Model.Profile.ProfileID;
}

<div>
    <partial name="_InvolvingPeriodPartial" model="Model.PageViewModel.TimeSpan" />
    <div id="involving-container">
        <partial name="_InvolvingListPartial" model="Model.PageViewModel" />
    </div>
    <div id="loading" style="display: none;" class="text-center">
        <p>正在加載更多...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/utils.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var profileId = "@Model.Profile.ProfileID";
            var timeSpan = "@Model.PageViewModel.TimeSpan";
            setupInfiniteScroll('#involving-container', '#loading', 'LoadMore', { id: profileId, timeSpan: timeSpan });
        });
    </script>
}