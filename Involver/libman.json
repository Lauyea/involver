{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "jsdelivr",
      "library": "bootstrap@5.3.8",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "LICENSE",
        "README.md",
        "dist/css/bootstrap.css",
        "dist/css/bootstrap.css.map",
        "dist/js/bootstrap.bundle.js",
        "dist/js/bootstrap.bundle.js.map"
      ]
    },
    {
      "library": "vue@3.5.22",
      "destination": "wwwroot/lib/vue/",
      "files": [
        "vue.global.min.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "ckeditor5@49.1.0",
      "destination": "wwwroot/lib/ckeditor5/",
      "files": [
        "LICENSE.md",
        "dist/browser/ckeditor5.js",
        "dist/browser/ckeditor5-content.css",
        "dist/browser/ckeditor5-editor.css",
        "dist/translations/zh.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "chart.js@4.5.1",
      "destination": "wwwroot/lib/chart.js/",
      "files": [
        "LICENSE.md",
        "dist/chart.js",
        "dist/chunks/helpers.dataset.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "@kurkle/color@0.3.4",
      "destination": "wwwroot/lib/kurkle-color/",
      "files": [
        "LICENSE.md",
        "dist/color.esm.js"
      ]
    }
  ]
}