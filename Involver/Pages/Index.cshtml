@page
@model Involver.Pages.IndexModel
@{
    ViewData["Title"] = "屬於每個人的創作";
}
<partial name="_StatusMessage" model="Model.StatusMessage" />

@section Styles {
    @if (Model.UserProfile == null)
    {
        <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/feed.css" asp-append-version="true" />
    }
    else
    {
        <link rel="stylesheet" href="~/css/feed.css" asp-append-version="true" />
    }
}

@section Scripts {
    @if (Model.UserProfile == null)
    {
        <script type="module" src="~/js/home-hero.js" asp-append-version="true"></script>
    }
    else
    {
        <script type="module" src="~/js/recommendations/home-feed.js" asp-append-version="true"></script>
    }
}

@if (Model.UserProfile != null)
{
    var feed = Model.Feed;
    var userId = Model.UserProfile.ProfileID;

    <partial name="_FeedTabsPartial" model="Involver.Models.ViewModels.Feed.FeedTab.Home" />
    <h1 class="visually-hidden">為你推薦</h1>

    <div class="home-feed" id="home-feed" data-feed-request-id="@feed.FeedRequestId">
        @Html.AntiForgeryToken()

        @* 1. 繼續閱讀：追蹤中有新章節的作品 *@
        <section class="feed-section" aria-labelledby="feed-continue-title">
            <header class="feed-section__header">
                <h2 id="feed-continue-title" class="feed-section__title">
                    <i class="fas fa-book-bookmark" aria-hidden="true"></i>繼續閱讀
                </h2>
                <a class="feed-section__more" asp-area="Identity" asp-page="/Profile/Follow" asp-route-id="@userId">追蹤中的作品</a>
            </header>
            @if (feed.ContinueReading.Count > 0)
            {
                <div class="feed-scroller">
                    @foreach (var card in feed.ContinueReading)
                    {
                        <div class="feed-scroller__item">
                            <partial name="_ContentCardPartial" model="card" />
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="feed-section__empty">
                    @if (feed.HasFollowedNovels)
                    {
                        <text>追蹤中的作品都讀完了，有新章節時會出現在這裡。</text>
                    }
                    else
                    {
                        <text>還沒有追蹤任何作品。在作品頁按「追蹤」，有新章節時就會出現在這裡。</text>
                    }
                </p>
            }
        </section>

        @* 2. 投票進行中：Involver 最有特色的互動，放在顯眼位置 *@
        @if (feed.Votings.Count > 0)
        {
            <section class="feed-section feed-section--votings" aria-labelledby="feed-votings-title">
                <header class="feed-section__header">
                    <h2 id="feed-votings-title" class="feed-section__title">
                        <i class="fas fa-check-to-slot" aria-hidden="true"></i>投票進行中
                    </h2>
                    <a class="feed-section__more" asp-page="/Descriptions/Voting">投票怎麼玩？</a>
                </header>
                <ul class="feed-votings">
                    @foreach (var voting in feed.Votings)
                    {
                        <li class="feed-voting @(voting.Urgent ? "feed-voting--urgent" : "")">
                            <a class="feed-voting__link" asp-page="/Episodes/Details" asp-route-id="@voting.EpisodeId">
                                <span class="feed-voting__title">@voting.Title</span>
                                <span class="feed-voting__source">《@voting.NovelTitle》@voting.EpisodeTitle</span>
                            </a>
                            <span class="feed-voting__remaining" title="@voting.DeadLine">
                                <i class="fas @(voting.DeadLine != null ? "fa-hourglass-half" : "fa-users")" aria-hidden="true"></i>@voting.Remaining
                            </span>
                        </li>
                    }
                </ul>
            </section>
        }

        @* 3. 為你推薦：卡片網格，每張附推薦理由，可以按「不感興趣」 *@
        <section class="feed-section" id="feed-recommended" aria-labelledby="feed-recommended-title">
            <header class="feed-section__header">
                <h2 id="feed-recommended-title" class="feed-section__title">
                    <i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i>為你推薦
                </h2>
            </header>

            @if (feed.NeedsCategoryPicker || feed.PreferredCategoryIds.Count > 0)
            {
                <details class="feed-type-picker" open="@feed.NeedsCategoryPicker">
                    <summary class="feed-type-picker__summary">
                        @(feed.NeedsCategoryPicker ? $"選 {Model.MaxPreferredCategories} 個你喜歡的分類，我們從這裡開始推薦" : "調整喜歡的分類")
                    </summary>
                    <form method="post" asp-page-handler="Preferences" class="feed-type-picker__form">
                        <div class="feed-type-picker__options" data-max-checked="@Model.MaxPreferredCategories">
                            @foreach (var option in feed.CategoryOptions)
                            {
                                var inputId = $"preferred-category-{option.TagId}";
                                <input type="checkbox" class="btn-check" id="@inputId" name="SelectedCategoryIds" value="@option.TagId"
                                       checked="@feed.PreferredCategoryIds.Contains(option.TagId)" autocomplete="off" />
                                <label class="category-chip" for="@inputId">
                                    <i class="fas fa-check category-chip__check" aria-hidden="true"></i>
                                    <i class="fas @option.Icon category-chip__icon" aria-hidden="true"></i>@option.Name
                                </label>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">儲存</button>
                    </form>
                </details>
            }

            @if (feed.Recommended.Count > 0)
            {
                <div class="feed-grid">
                    @foreach (var card in feed.Recommended)
                    {
                        <partial name="_ContentCardPartial" model="card" />
                    }
                </div>
            }
            else if (!feed.NeedsCategoryPicker)
            {
                <p class="feed-section__empty">多讀幾部作品、追蹤喜歡的作者，推薦會越來越準。先從下面的熱門與新作逛起吧！</p>
            }
        </section>

        @* 4. 熱門／新作：給還沒有行為資料的人逛 *@
        <section class="feed-section" aria-labelledby="feed-trending-title">
            <header class="feed-section__header">
                <h2 id="feed-trending-title" class="feed-section__title">
                    <i class="fas fa-fire" aria-hidden="true"></i>熱門創作
                </h2>
                <a class="feed-section__more" asp-page="/Feed/TrendingCreations">查看更多</a>
            </header>
            @if (feed.Trending.Count > 0)
            {
                <div class="feed-grid feed-grid--ranked">
                    @foreach (var card in feed.Trending)
                    {
                        <partial name="_ContentCardPartial" model="card" />
                    }
                </div>
            }
            else
            {
                <p class="feed-section__empty">目前還沒有作品。</p>
            }
        </section>

        <section class="feed-section" aria-labelledby="feed-newest-title">
            <header class="feed-section__header">
                <h2 id="feed-newest-title" class="feed-section__title">
                    <i class="fas fa-seedling" aria-hidden="true"></i>新作
                </h2>
                <a class="feed-section__more" asp-page="/Novels/Index">查看更多</a>
            </header>
            @if (feed.Newest.Count > 0)
            {
                <div class="feed-grid">
                    @foreach (var card in feed.Newest)
                    {
                        <partial name="_ContentCardPartial" model="card" />
                    }
                </div>
            }
            else
            {
                <p class="feed-section__empty">目前還沒有作品。</p>
            }
        </section>
    </div>
}
else
{
    <section id="story-hero" class="story-hero" aria-labelledby="story-hero-title">
        <canvas class="story-hero__canvas" aria-hidden="true"></canvas>
        <div class="story-hero__veil"></div>
        <div class="story-hero__content">
            <p class="story-hero__eyebrow">INVOLVER · 讀者參與的創作平台</p>
            <h1 id="story-hero-title" class="story-hero__title">
                <span class="story-hero__line">你的選擇，</span>
                <span class="story-hero__line">決定故事的<span class="story-hero__highlight">下一頁</span>。</span>
            </h1>
            <p class="story-hero__lead">
                在 Involver，讀者不只是讀者。為劇情投下關鍵一票、在留言區和作者討論，
                和喜歡的創作者一起把故事推向你想看的方向。
            </p>
            <div class="story-hero__actions">
                <a asp-area="" asp-page="/Novels/Index" class="btn btn-lg home-button home-button--primary">
                    開始探索故事<i class="fas fa-arrow-right ms-2"></i>
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-lg home-button home-button--ghost">
                    免費加入
                </a>
            </div>
            <p class="story-hero__hint" aria-hidden="true">
                <i class="fas fa-seedling"></i>
                <span class="story-hero__hint-pointer">按住滑鼠，引導光之樹往那裡生長</span>
                <span class="story-hero__hint-touch">按住畫面，引導光之樹往那裡生長</span>
            </p>
        </div>
    </section>

    @if (Model.Trending.Count > 0)
    {
        <section class="home-section" aria-labelledby="home-trending-title">
            <header class="home-section__header">
                <h2 id="home-trending-title" class="home-section__title">大家正在讀</h2>
                <p class="home-section__subtitle">最近 @Involver.Services.Recommendations.HomeFeedService.TrendingDays 天最多讀者在看的作品，不用登入就能讀。</p>
            </header>
            <div class="feed-grid feed-grid--ranked">
                @foreach (var card in Model.Trending)
                {
                    <partial name="_ContentCardPartial" model="card" />
                }
            </div>
            <div class="text-center mt-4">
                <a asp-page="/Feed/TrendingCreations" class="btn btn-lg home-button home-button--outline">看完整熱門排行</a>
            </div>
        </section>
    }

    <section class="home-section" aria-labelledby="home-steps-title">
        <header class="home-section__header">
            <h2 id="home-steps-title" class="home-section__title">故事怎麼往下走？</h2>
            <p class="home-section__subtitle">在這裡，每一位讀者手上都握著一支筆。</p>
        </header>
        <ol class="home-steps">
            <li class="home-step">
                <span class="home-step__number" aria-hidden="true">01</span>
                <span class="home-step__icon" aria-hidden="true"><i class="fas fa-book-open"></i></span>
                <h3 class="home-step__title">走進一個故事</h3>
                <p class="home-step__text">從奇幻、懸疑到日常，挑一部喜歡的連載，跟著作者一章一章讀下去。</p>
            </li>
            <li class="home-step">
                <span class="home-step__number" aria-hidden="true">02</span>
                <span class="home-step__icon" aria-hidden="true"><i class="fas fa-code-branch"></i></span>
                <h3 class="home-step__title">投下你的選擇</h3>
                <p class="home-step__text">作者會在章節裡設下投票，讓讀者決定角色的下一步。投入 In 幣，讓你支持的走向更有機會勝出。</p>
            </li>
            <li class="home-step">
                <span class="home-step__number" aria-hidden="true">03</span>
                <span class="home-step__icon" aria-hidden="true"><i class="fas fa-feather-pointed"></i></span>
                <h3 class="home-step__title">一起寫下去</h3>
                <p class="home-step__text">在留言區討論劇情，或 Involve 支持作者，讓你期待的下一頁更快到來。</p>
            </li>
        </ol>
    </section>

    <section class="home-section home-cta" aria-labelledby="home-cta-title">
        <h2 id="home-cta-title" class="home-cta__title">下一頁，由你決定。</h2>
        <p class="home-cta__text">免費註冊，參與你的第一個故事。</p>
        <div class="home-cta__actions">
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-lg home-button home-button--primary">免費加入 Involver</a>
            <a asp-area="" asp-page="/Novels/Index" class="btn btn-lg home-button home-button--outline">先逛逛作品</a>
        </div>
    </section>
}

