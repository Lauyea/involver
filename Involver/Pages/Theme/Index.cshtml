@page
@model Involver.Pages.Theme.IndexModel
@{
    ViewData["Title"] = "主題檢查";
}

@section Styles {
    <link rel="stylesheet" href="~/css/feed.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@*
    site.css 的主題檢查頁：修改主題色之後，在淺色、深色模式各看一次。
    每個「底色＋前景色」組合旁邊的數字是即時計算的對比（theme-preview.js），一般文字要 4.5 以上。
*@

<header class="theme-preview__header">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-body-secondary mb-0">
            色彩依 <a href="https://m3.material.io/styles/color/roles" target="_blank" rel="noopener">Material Design 3 的色彩角色</a>設計，
            種子色是品牌 icon 的 <code>#FFAA55</code>；元件沿用 Bootstrap 5.3。
            數字是即時計算的對比，一般文字要 4.5 以上，圖示與框線要 3 以上。
        </p>
    </div>
    <div class="btn-group" role="group" aria-label="切換主題">
        <button type="button" class="btn btn-outline-secondary" aria-pressed="false" data-theme-choice="light"><i class="fa-solid fa-sun me-1" aria-hidden="true"></i>淺色</button>
        <button type="button" class="btn btn-outline-secondary" aria-pressed="false" data-theme-choice="dark"><i class="fa-solid fa-moon me-1" aria-hidden="true"></i>深色</button>
        <button type="button" class="btn btn-outline-secondary" aria-pressed="false" data-theme-choice="auto"><i class="fa-solid fa-circle-half-stroke me-1" aria-hidden="true"></i>自動</button>
    </div>
</header>

<section class="theme-preview__section" aria-labelledby="theme-brand">
    <h2 id="theme-brand">品牌</h2>
    <p class="text-body-secondary">
        <code>--brand-color</code> 是 icon 本身的顏色，只給 logo 與品牌漸層這類裝飾用。
        品牌漸層只用在頂部導覽列與首頁的行動呼籲區，上面的文字用 <code>--brand-on-gradient</code>。
    </p>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="theme-preview__brand-icon">
                <img src="/favicon.ico" alt="Involver 的品牌 icon" width="48" height="48" />
                <div>
                    <strong>--brand-color</strong>
                    <div class="theme-preview__value" data-color-value="--brand-color"></div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="theme-preview__gradient navbar-themed" data-contrast-bg="--brand-gradient-end" data-contrast-fg="--brand-on-gradient-muted">
                <span class="theme-preview__gradient-brand">
                    <img src="/favicon.ico" alt="" width="28" height="28" />
                    Involver
                </span>
                <span>導覽連結</span>
                <span class="theme-preview__ratio" data-ratio-label="連結對比（漸層最深處）"></span>
            </div>
        </div>
    </div>
    <div class="home-cta mt-3">
        <h3 class="home-cta__title">首頁行動呼籲區</h3>
        <p class="home-cta__text">品牌漸層的第二個用途，深色模式會換成深色漸層。</p>
        <div class="home-cta__actions">
            <a href="#" class="btn home-button home-button--primary">主要行動</a>
            <a href="#" class="btn home-button home-button--outline">次要行動</a>
        </div>
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-roles">
    <h2 id="theme-roles">強調色角色</h2>
    <p class="text-body-secondary">
        每個角色都有四個顏色：底色、底色上的文字（on-）、容器色（-container）與容器上的文字。
        淺色模式的底色是 tone 40，深色模式是 tone 80；主色另有實心元件用的 primary-fill。
    </p>
    <div class="theme-preview__roles">
        @foreach (var group in Model.AccentRoles)
        {
            <article class="theme-preview__role">
                <div class="theme-preview__role-head">
                    <h3 class="h6 mb-0">@group.Label <code>@group.Role</code></h3>
                    <span class="text-body-secondary small">Bootstrap：<code>@group.BootstrapName</code></span>
                </div>
                <p class="theme-preview__role-usage">@group.Usage</p>
                <div class="theme-preview__pair" style="background-color: var(--md-@group.Role); color: var(--md-on-@group.Role);"
                     data-contrast-bg="--md-@group.Role" data-contrast-fg="--md-on-@group.Role">
                    <span>@group.Role / on-@group.Role</span>
                    <span class="theme-preview__ratio"></span>
                    <span class="theme-preview__value" data-color-value="--md-@group.Role"></span>
                </div>
                @if (group.Role == "primary")
                {
                    @* 實心元件用的亮橘（M3 Fidelity：淺色模式直接用種子色） *@
                    <div class="theme-preview__pair" style="background-color: var(--md-primary-fill); color: var(--md-on-primary-fill);"
                         data-contrast-bg="--md-primary-fill" data-contrast-fg="--md-on-primary-fill">
                        <span>primary-fill（實心元件）</span>
                        <span class="theme-preview__ratio"></span>
                        <span class="theme-preview__value" data-color-value="--md-primary-fill"></span>
                    </div>
                }
                <div class="theme-preview__pair" style="background-color: var(--md-@(group.Role)-container); color: var(--md-on-@(group.Role)-container);"
                     data-contrast-bg="--md-@(group.Role)-container" data-contrast-fg="--md-on-@(group.Role)-container">
                    <span>@(group.Role)-container</span>
                    <span class="theme-preview__ratio"></span>
                    <span class="theme-preview__value" data-color-value="--md-@(group.Role)-container"></span>
                </div>
                <div class="theme-preview__pair theme-preview__pair--text" style="color: var(--md-@group.Role);"
                     data-contrast-bg="--md-surface" data-contrast-fg="--md-@group.Role">
                    <span>文字與圖示 <i class="fa-solid fa-star" aria-hidden="true"></i></span>
                    <span class="theme-preview__ratio"></span>
                </div>
            </article>
        }
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-surfaces">
    <h2 id="theme-surfaces">表面、文字與框線</h2>
    <p class="text-body-secondary">M3 用表面的深淺表示層次，越上層的元件用越高的 surface-container。</p>
    <div class="theme-preview__surfaces">
        @foreach (var surface in Model.SurfaceRoles)
        {
            <div class="theme-preview__surface" style="background-color: var(--md-@surface.Role);"
                 data-contrast-bg="--md-@surface.Role" data-contrast-fg="--md-on-surface-variant">
                <strong>@surface.Role</strong>
                <span class="theme-preview__surface-usage">@surface.Usage</span>
                @if (surface.LegacyVariable is not null)
                {
                    <code>@surface.LegacyVariable</code>
                }
                <span class="theme-preview__ratio" data-ratio-label="次要文字"></span>
            </div>
        }
    </div>
    <div class="row g-3 mt-1">
        <div class="col-sm-6 col-lg-3">
            <div class="theme-preview__line" data-contrast-bg="--md-surface" data-contrast-fg="--md-on-surface">
                <span style="color: var(--md-on-surface);">on-surface 主要文字</span>
                <span class="theme-preview__ratio"></span>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="theme-preview__line" data-contrast-bg="--md-surface" data-contrast-fg="--md-on-surface-variant">
                <span style="color: var(--md-on-surface-variant);">on-surface-variant 次要文字</span>
                <span class="theme-preview__ratio"></span>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="theme-preview__line" style="border-color: var(--md-outline);" data-contrast-bg="--md-surface" data-contrast-fg="--md-outline">
                <span>outline 輸入框、外框按鈕</span>
                <span class="theme-preview__ratio" data-ratio-min="3"></span>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="theme-preview__line" style="border-color: var(--md-outline-variant);">
                <span>outline-variant 分隔線、卡片框（裝飾用，不需 3:1）</span>
            </div>
        </div>
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-typography">
    <h2 id="theme-typography">文字</h2>
    <h1>h1 標題</h1>
    <h2>h2 標題</h2>
    <h3>h3 標題</h3>
    <h4>h4 標題</h4>
    <h5>h5 標題</h5>
    <h6>h6 標題</h6>
    <p>一般段落文字，包含<a href="#">文字連結</a>、<mark>標記文字</mark>與 <code>inline code</code>。</p>
    <p class="text-body-secondary">次要文字（<code>.text-body-secondary</code>）。</p>
    <p>語意文字：
        @foreach (var variant in Model.BootstrapVariants)
        {
            <span class="text-@variant me-2">@variant</span>
        }
    </p>
    <blockquote class="blockquote mb-0">
        <p>引用區塊，用來和前後文區隔。</p>
    </blockquote>
</section>

<section class="theme-preview__section" aria-labelledby="theme-buttons">
    <h2 id="theme-buttons">按鈕</h2>
    <p class="text-body-secondary">
        實心按鈕是 M3 的 filled button，secondary 是 tonal button，外框按鈕是 outlined button。
        滑鼠移過疊 8% 前景色，按下疊 12%。
    </p>
    <div class="theme-preview__row">
        @foreach (var variant in Model.BootstrapVariants)
        {
            <button type="button" class="btn btn-@variant">@variant</button>
        }
        <button type="button" class="btn btn-primary" disabled>disabled</button>
    </div>
    <div class="theme-preview__row">
        @foreach (var variant in Model.BootstrapVariants)
        {
            <button type="button" class="btn btn-outline-@variant">@variant</button>
        }
        <button type="button" class="btn btn-link">link</button>
    </div>
    <div class="theme-preview__row">
        <input type="radio" class="btn-check" name="theme-toggle" id="theme-toggle-1" autocomplete="off" checked>
        <label class="btn btn-outline-primary" for="theme-toggle-1">選中</label>
        <input type="radio" class="btn-check" name="theme-toggle" id="theme-toggle-2" autocomplete="off">
        <label class="btn btn-outline-primary" for="theme-toggle-2">未選中</label>
        <input type="checkbox" class="btn-check" id="theme-toggle-3" autocomplete="off" checked>
        <label class="btn btn-outline-secondary" for="theme-toggle-3">secondary 選中</label>
    </div>
    <p class="text-body-secondary small mb-2">社群登入按鈕維持各平台的品牌色，不跟主題變動：</p>
    <div class="theme-preview__row">
        <button type="button" class="btn btn-facebook"><i class="fab fa-facebook-f" aria-hidden="true"></i> Facebook</button>
        <button type="button" class="btn btn-twitter"><i class="fab fa-twitter" aria-hidden="true"></i> Twitter</button>
        <button type="button" class="btn btn-google"><i class="fab fa-google" aria-hidden="true"></i> Google</button>
        <button type="button" class="btn btn-linkedin"><i class="fab fa-linkedin-in" aria-hidden="true"></i> LinkedIn</button>
        <button type="button" class="btn btn-microsoft"><i class="fab fa-microsoft" aria-hidden="true"></i> Microsoft</button>
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-forms">
    <h2 id="theme-forms">表單</h2>
    <div class="row g-3">
        <div class="col-md-6">
            <label for="theme-input" class="form-label">文字輸入</label>
            <input type="text" class="form-control" id="theme-input" placeholder="提示文字">
        </div>
        <div class="col-md-6">
            <label for="theme-select" class="form-label">下拉選單</label>
            <select class="form-select" id="theme-select">
                <option>選項一</option>
                <option>選項二</option>
            </select>
        </div>
        <div class="col-md-6">
            <label for="theme-invalid" class="form-label">驗證失敗</label>
            <input type="text" class="form-control is-invalid" id="theme-invalid" value="錯誤的值" aria-describedby="theme-invalid-feedback">
            <div id="theme-invalid-feedback" class="invalid-feedback">請輸入正確的值。</div>
        </div>
        <div class="col-md-6">
            <label for="theme-disabled" class="form-label">停用</label>
            <input type="text" class="form-control" id="theme-disabled" value="無法編輯" disabled>
        </div>
        <div class="col-md-6">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="theme-check-1" checked>
                <label class="form-check-label" for="theme-check-1">已勾選</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="theme-check-2">
                <label class="form-check-label" for="theme-check-2">未勾選</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="theme-radio" id="theme-radio-1" checked>
                <label class="form-check-label" for="theme-radio-1">選項 A</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="theme-radio" id="theme-radio-2">
                <label class="form-check-label" for="theme-radio-2">選項 B</label>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="theme-switch-1" checked>
                <label class="form-check-label" for="theme-switch-1">開關（開）</label>
            </div>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="theme-switch-2">
                <label class="form-check-label" for="theme-switch-2">開關（關）</label>
            </div>
            <label for="theme-range" class="form-label mt-2">滑桿</label>
            <input type="range" class="form-range" id="theme-range">
        </div>
        <div class="col-12">
            <partial name="_CategoryPickerPartial" model="Model.CategoryPicker" />
        </div>
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-feedback">
    <h2 id="theme-feedback">提示與狀態</h2>
    @foreach (var variant in Model.BootstrapVariants)
    {
        <div class="alert alert-@variant" role="alert">
            <code>alert-@variant</code>：提示訊息，含<a href="#" class="alert-link">提示內的連結</a>。
        </div>
    }
    <div class="theme-preview__row">
        @foreach (var variant in Model.BootstrapVariants)
        {
            <span class="badge bg-@variant">bg-@variant</span>
        }
    </div>
    <div class="theme-preview__row">
        @foreach (var variant in Model.BootstrapVariants)
        {
            <span class="badge text-bg-@variant">text-bg-@variant</span>
        }
    </div>
    <div class="progress mb-3" role="progressbar" aria-label="進度範例" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width: 60%">60%</div>
    </div>
    <div class="feed-empty">
        <div class="feed-empty__icon"><i class="fa-solid fa-feather" aria-hidden="true"></i></div>
        <p class="feed-empty__title">空狀態</p>
        <p class="feed-empty__text">圖示、一句說明，再加上下一步的按鈕。</p>
        <a href="#" class="btn btn-primary">下一步</a>
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-navigation">
    <h2 id="theme-navigation">導覽</h2>
    <partial name="_FeedTabsPartial" model="Involver.Models.ViewModels.Feed.FeedTab.Home" />

    <p class="mt-4 mb-2"><strong>麵包屑</strong></p>
    <nav aria-label="麵包屑範例">
        <ol class="breadcrumb p-3">
            <li class="breadcrumb-item"><a href="#">首頁</a></li>
            <li class="breadcrumb-item"><a href="#">創作</a></li>
            <li class="breadcrumb-item active" aria-current="page">目前頁面</li>
        </ol>
    </nav>

    <p class="mt-4 mb-2"><strong>分頁</strong></p>
    <nav aria-label="分頁範例">
        <ul class="pagination">
            <li class="page-item disabled"><a class="page-link">上一頁</a></li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item active" aria-current="page"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item"><a class="page-link" href="#">下一頁</a></li>
        </ul>
    </nav>

    <p class="mt-4 mb-2"><strong>Nav pills</strong></p>
    <ul class="nav nav-pills">
        <li class="nav-item"><a class="nav-link active" aria-current="page" href="#">選中</a></li>
        <li class="nav-item"><a class="nav-link" href="#">連結</a></li>
        <li class="nav-item"><a class="nav-link" href="#">另一個連結</a></li>
    </ul>

    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <p class="mb-2"><strong>下拉選單</strong>（直接展開顯示）</p>
            <ul class="dropdown-menu theme-preview__dropdown">
                <li><h6 class="dropdown-header">標題</h6></li>
                <li><a class="dropdown-item" href="#">一般項目</a></li>
                <li><a class="dropdown-item active" href="#" aria-current="true">選中項目</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item disabled" aria-disabled="true">停用項目</a></li>
            </ul>
        </div>
        <div class="col-md-6">
            <p class="mb-2"><strong>清單</strong></p>
            <div class="list-group">
                <a href="#" class="list-group-item list-group-item-action active" aria-current="true">選中項目</a>
                <a href="#" class="list-group-item list-group-item-action">一般項目</a>
                <a href="#" class="list-group-item list-group-item-action">一般項目</a>
            </div>
        </div>
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-cards">
    <h2 id="theme-cards">卡片</h2>
    <div class="row g-3">
        <div class="col-md-6">
            @* 和投票卡片（Components/Voting）一樣有 card-footer，用來檢查深色模式下底部不會變白 *@
            <div class="card h-100">
                <div class="card-header">卡片標頭</div>
                <div class="card-body">
                    <h3 class="card-title h5">一般卡片</h3>
                    <p class="card-text">卡片內文，用來確認卡片背景與文字的對比。</p>
                    <a href="#" class="btn btn-primary">前往</a>
                </div>
                <div class="card-footer text-body-secondary small">
                    <i class="far fa-clock me-1" aria-hidden="true"></i>卡片底部（投票卡片的剩餘時間）
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card hover-effect h-100">
                <div class="card-body">
                    <h3 class="card-title h5">有滑鼠移過效果的卡片</h3>
                    <p class="card-text">滑鼠移過時會上移並加上陰影。</p>
                    <a href="#" class="btn btn-outline-primary">前往</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="theme-preview__section" aria-labelledby="theme-custom">
    <h2 id="theme-custom">自訂樣式</h2>

    <p class="mb-2"><strong>標籤雲</strong></p>
    <div class="tag-cloud-container p-3 d-flex flex-wrap gap-2 align-items-center">
        <a href="#" class="tag-item tag-size-5">大標籤 <span class="tag-count">50</span></a>
        <a href="#" class="tag-item tag-size-4">較大 <span class="tag-count">40</span></a>
        <a href="#" class="tag-item tag-size-3">一般 <span class="tag-count">30</span></a>
        <a href="#" class="tag-item tag-size-2">較小 <span class="tag-count">20</span></a>
        <a href="#" class="tag-item tag-size-1">最小 <span class="tag-count">10</span></a>
    </div>

    <p class="mt-4 mb-2"><strong>擲骰結果</strong></p>
    <div class="dice-roll-info">擲出 2d6，結果：8</div>

    <p class="mt-4 mb-2"><strong>通知數量與狀態點</strong></p>
    <span class="fa-stack fa-2x" data-count="12">
        <i class="fa fa-solid fa-bell fa-stack-1x" aria-hidden="true"></i>
    </span>
    <span class="ms-3">有新狀態 <span class="dot"></span></span>

    <p class="mt-4 mb-2"><strong>排行獎牌</strong>（金銀銅的漸層代表名次，不跟主題變動）</p>
    <div class="theme-preview__row">
        <div class="p-3 rounded gold text-dark">.gold</div>
        <div class="p-3 rounded silver text-dark">.silver</div>
        <div class="p-3 rounded bronze text-dark">.bronze</div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/tools/theme-preview.js" asp-append-version="true"></script>
}
