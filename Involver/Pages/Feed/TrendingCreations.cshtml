@page
@model Involver.Pages.Feed.TrendingCreationsModel
@using Involver.Models.ViewModels.Feed
@using Involver.Services.Recommendations
@{
    ViewData["Title"] = "熱門創作";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/feed.css" asp-append-version="true" />
}

@if (Model.UserProfileID != null)
{
    <partial name="_FeedTabsPartial" model="FeedTab.Trending" />
    <h1 class="visually-hidden">熱門創作</h1>
}
else
{
    <h1 class="feed-page-title"><i class="fas fa-fire" aria-hidden="true"></i>熱門創作</h1>
}

<p class="feed-caption">最近 @HomeFeedService.TrendingDays 天最多讀者在看的作品</p>

@if (Model.Novels.Count > 0)
{
    <div class="feed-grid feed-grid--ranked">
        @foreach (var card in Model.Novels)
        {
            <partial name="_ContentCardPartial" model="card" />
        }
    </div>
}
else
{
    <div class="feed-empty">
        <i class="fas fa-book-open feed-empty__icon" aria-hidden="true"></i>
        <p class="feed-empty__title">目前還沒有作品</p>
        <a class="btn btn-primary rounded-pill px-4" asp-page="/Novels/Index">看看所有創作</a>
    </div>
}
