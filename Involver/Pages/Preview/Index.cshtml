@page "{token?}"
@model Involver.Pages.Preview.IndexModel
@{
    ViewData["Title"] = "小說試閱";
    Layout = "~/Pages/Shared/_Layout.cshtml";
    ViewData["ReturnRightFunction"] = false;
}

@section Head {
    <meta name="robots" content="noindex, nofollow, noarchive" />
}

<div id="preview-app"
     data-token="@Model.Token"
     data-is-expired="@Model.IsExpired.ToString().ToLower()"
     data-is-revoked="@Model.IsRevoked.ToString().ToLower()">

    <!-- 試閱已被撤銷狀態 -->
    <div v-if="isRevoked" class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-danger shadow-sm mb-4">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="fas fa-ban"></i> 此試閱已被撤銷</h5>
                </div>
                <div class="card-body py-4 text-center">
                    <div class="my-3 text-danger" style="font-size: 3rem;">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <h5 class="card-title">內容已不可再閱覽</h5>
                    <p class="card-text text-body-secondary">
                        作者已撤銷此小說試閱。此連結永久失效，無法再進行閱讀。
                    </p>
                    <a asp-page="/Index" class="btn btn-outline-secondary mt-3">
                        <i class="fas fa-home"></i> 回到首頁
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 試閱過期狀態 -->
    <div v-else-if="isExpired" class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-warning shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-clock"></i> 此試閱已過期</h5>
                </div>
                <div class="card-body py-4 text-center">
                    <div class="my-3 text-warning" style="font-size: 3rem;">
                        <i class="fas fa-hourglass-end"></i>
                    </div>
                    <h5 class="card-title">已超過有效期限</h5>
                    <p class="card-text text-body-secondary">
                        此小說試閱連結已過期，無法再透過此網址取得試閱內容。
                    </p>
                    <a asp-page="/Index" class="btn btn-outline-secondary mt-3">
                        <i class="fas fa-home"></i> 回到首頁
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 小說內容呈現（驗證成功後） -->
    <div v-else-if="preview" class="card mb-4 shadow-sm">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="mb-0 text-break">{{ preview.title }}</h1>
                <div class="d-flex justify-content-end flex-wrap">
                    <button class="btn btn-sm btn-outline-danger m-1" @@click="showRevokeModal = true" title="撤銷試閱">
                        <i class="fas fa-ban"></i> 撤銷試閱
                    </button>
                    <button class="btn btn-sm btn-outline-secondary m-1" @@click="lockAgain" title="重新上鎖">
                        <i class="fas fa-lock"></i> 重新上鎖
                    </button>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="text-body-secondary mb-3">
                <small><i class="far fa-calendar-alt"></i> 建立於：<span>{{ formatDate(preview.createdAt) }}</span></small>
                <small class="ms-3"><i class="far fa-clock"></i> 有效至：<span>{{ formatDate(preview.expiresAt) }}</span></small>
            </div>
            <article class="ck-content" v-html="preview.contentHtml">
            </article>
        </div>
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted"><i class="fas fa-shield-alt text-success"></i> 小說試閱保護中</small>
            <button class="btn btn-sm btn-outline-secondary" @@click="lockAgain">
                <i class="fas fa-lock"></i> 離開試閱
            </button>
        </div>
    </div>

    <!-- 密碼輸入表單（預設狀態） -->
    <div v-else class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-10">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-lock text-primary"></i> 小說試閱</h5>
                    <button class="btn btn-sm btn-outline-danger" @@click="showRevokeModal = true" title="撤銷此試閱">
                        <i class="fas fa-ban"></i> 撤銷試閱
                    </button>
                </div>
                <div class="card-body">
                    <p class="text-body-secondary mb-3">
                        這是一份受保護的小說試閱，請輸入作者提供的<strong>閱讀密碼</strong>以解鎖並檢視小說內容：
                    </p>

                    <div v-if="error" class="alert alert-danger d-flex align-items-center mb-3" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <div>{{ error }}</div>
                    </div>

                    <form @@submit.prevent="submitPassword" onsubmit="return false;">
                        <div class="mb-3">
                            <label for="readingPasswordInput" class="form-label fw-bold">
                                <i class="fas fa-key text-warning"></i> 閱讀密碼
                            </label>
                            <input type="password"
                                   id="readingPasswordInput"
                                   v-model="password"
                                   class="form-control"
                                   placeholder="請輸入閱讀密碼"
                                   autocomplete="current-password"
                                   :disabled="isLoading"
                                   @@keyup.enter="submitPassword"
                                   ref="passwordInput" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <button type="button" class="btn btn-link text-muted p-0 text-decoration-none" @@click="showRevokeModal = true">
                                <small><i class="fas fa-undo"></i> 撤銷此試閱？</small>
                            </button>
                            <button type="button" @@click="submitPassword" class="btn btn-primary" :disabled="isLoading || !password">
                                <span v-if="isLoading" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                <i v-else class="fas fa-unlock me-1"></i>
                                閱讀小說
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- 撤銷試閱 Modal -->
    <div v-if="showRevokeModal" class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="fas fa-ban"></i> 撤銷小說試閱
                    </h5>
                    <button type="button" class="btn-close" @@click="closeRevokeModal" :disabled="isRevoking" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div v-if="revokeSuccess" class="alert alert-success d-flex align-items-center">
                        <i class="fas fa-check-circle me-2"></i>
                        <div>{{ revokeSuccess }}</div>
                    </div>
                    <div v-else>
                        <p class="text-muted">
                            一旦撤銷，此試閱連結將<strong>永久失效</strong>，包含持有閱讀密碼的所有人將無法再閱覽內容。
                        </p>

                        <div v-if="revokeError" class="alert alert-danger d-flex align-items-center mb-3">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <div>{{ revokeError }}</div>
                        </div>

                        <div class="mb-3">
                            <label for="revokePasswordInput" class="form-label fw-bold">
                                <i class="fas fa-lock text-danger"></i> 請輸入撤銷密碼
                            </label>
                            <input type="password"
                                   id="revokePasswordInput"
                                   v-model="revokePassword"
                                   class="form-control"
                                   placeholder="輸入建立時設定的撤銷密碼"
                                   autocomplete="off"
                                   :disabled="isRevoking"
                                   @@keyup.enter="submitRevoke" />
                            <div class="form-text">提示：此密碼為建立試閱時由作者設定的撤銷專用密碼。</div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" v-if="!revokeSuccess">
                    <button type="button" class="btn btn-secondary" @@click="closeRevokeModal" :disabled="isRevoking">取消</button>
                    <button type="button" class="btn btn-danger" @@click="submitRevoke" :disabled="isRevoking || !revokePassword">
                        <span v-if="isRevoking" class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        <i v-else class="fas fa-trash-alt me-1"></i>
                        確認撤銷
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/components/preview.js" type="module" asp-append-version="true"></script>
}
