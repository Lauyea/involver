@page "{id}"
@model Involver.Pages.Novels.EditModel

@{
    ViewData["Title"] = "編輯創作";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.css" rel="stylesheet" type="text/css" />
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h1 class="mb-0 text-break flex-grow-1">編輯：@Model.Novel.Title</h1>
                    <a asp-page="./Details" asp-route-id="@Model.Novel.NovelID" class="btn btn-sm btn-outline-secondary"><i class="fas fa-eye"></i> 回到作品</a>
                </div>
            </div>
            <div class="card-body">
                <form enctype="multipart/form-data" method="post" class="needs-recaptcha" data-sitekey="@Configuration["reCAPTCHA_SiteKey"]" data-action="EditNovel">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }
                    <input type="hidden" asp-for="Novel.NovelID" />
                    <input type="hidden" asp-for="Novel.ProfileID" />
                    <input type="hidden" asp-for="Novel.Title" />

                    <div class="mb-3">
                        <label asp-for="Novel.Introduction" class="form-label"></label>
                        <textarea asp-for="Novel.Introduction" class="form-control" rows="6" placeholder="在這裡寫些東西..."></textarea>
                        <span asp-validation-for="Novel.Introduction" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Novel.ImageUrl" class="form-label"></label>
                        <input asp-for="Novel.ImageUrl" class="form-control">
                        <span asp-validation-for="Novel.ImageUrl" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Novel.Type" class="form-label"></label>
                        <select asp-for="Novel.Type" asp-items="Model.Types" class="form-select"></select>
                        <span asp-validation-for="Novel.Type" class="text-danger"></span>
                    </div>
                    <partial name="_TagInputPartial" model="Model.TagInput" />
                    <span asp-validation-for="TagString" class="text-danger"></span>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Novel.PrimeRead" />
                            <label class="form-check-label" asp-for="Novel.PrimeRead" title="只有付費會員才能閱讀最新章節">@Html.DisplayNameFor(model => model.Novel.PrimeRead)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Novel.End" />
                            <label class="form-check-label" asp-for="Novel.End">@Html.DisplayNameFor(model => model.Novel.End)</label>
                        </div>
                    </div>

                    <div class="mb-3 d-flex justify-content-end">
                        <a asp-page="./Details" asp-route-id="@Model.Novel.NovelID" class="btn btn-secondary me-2">取消</a>
                        <input type="submit" value="儲存" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@yaireo/tagify/dist/tagify.polyfills.min.js"></script>
    <script type="module" src="~/js/components/tag-input.js" asp-append-version="true"></script>
    <script src="https://www.google.com/recaptcha/api.js?render=@Configuration["reCAPTCHA_SiteKey"]" async defer></script>
}