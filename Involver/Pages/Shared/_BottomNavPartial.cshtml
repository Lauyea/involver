@inject SignInManager<InvolverUser> SignInManager

@*
    手機的底部導覽列（M3 的 navigation bar）：md 以下取代頁首的主要入口。
    最後一格是「我的」：登入後連到自己的個人檔案，未登入時連到登入頁。
*@
@{
    var requestPath = Context.Request.Path.Value ?? "/";
    var isSignedIn = SignInManager.IsSignedIn(User);
    var userId = isSignedIn ? userManager.GetUserId(User) : null;
    string profileId = Context.Request.Query["id"];

    // 「我的」只在看自己的頁面時標成目前位置：自己的個人檔案、我的書房、帳號管理；未登入時是登入與註冊頁
    var isMineActive = isSignedIn
        ? requestPath.StartsWith("/Identity/Account/Manage", StringComparison.OrdinalIgnoreCase)
            || (requestPath.StartsWith("/Identity/Profile", StringComparison.OrdinalIgnoreCase)
                && (string.IsNullOrEmpty(profileId) || profileId == userId))
        : requestPath.StartsWith("/Identity/Account/Login", StringComparison.OrdinalIgnoreCase)
            || requestPath.StartsWith("/Identity/Account/Register", StringComparison.OrdinalIgnoreCase);
}

<nav class="bottom-nav d-md-none" aria-label="快速導覽">
    <ul class="bottom-nav__list">
        @foreach (var item in SiteNavigation.PrimaryItems)
        {
            var isActive = item.IsActive(requestPath);
            <li>
                <a class="bottom-nav__item @(isActive ? "bottom-nav__item--active" : null)"
                   asp-area="" asp-page="@item.PagePath" aria-current="@(isActive ? "page" : null)">
                    <span class="bottom-nav__icon" aria-hidden="true"><i class="@item.IconClass"></i></span>
                    <span class="bottom-nav__label">@item.Label</span>
                </a>
            </li>
        }
        <li>
            @if (isSignedIn)
            {
                <a class="bottom-nav__item @(isMineActive ? "bottom-nav__item--active" : null)"
                   asp-area="Identity" asp-page="/Profile/Index" asp-route-id="@userId"
                   aria-current="@(isMineActive ? "page" : null)">
                    <span class="bottom-nav__icon" aria-hidden="true"><i class="fa-solid fa-circle-user"></i></span>
                    <span class="bottom-nav__label">我的</span>
                </a>
            }
            else
            {
                <a class="bottom-nav__item @(isMineActive ? "bottom-nav__item--active" : null)"
                   asp-area="Identity" asp-page="/Account/Login"
                   aria-current="@(isMineActive ? "page" : null)">
                    <span class="bottom-nav__icon" aria-hidden="true"><i class="fa-solid fa-right-to-bracket"></i></span>
                    <span class="bottom-nav__label">登入</span>
                </a>
            }
        </li>
    </ul>
</nav>
