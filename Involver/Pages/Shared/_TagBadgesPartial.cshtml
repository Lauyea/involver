@model Involver.Models.ViewModels.TagBadgesViewModel

@*
    作品上的標籤。正式標籤連到所在頁面的 Index 標籤搜尋；
    待審標籤只顯示，不出現在標籤搜尋裡，所以不加連結。
*@
@foreach (var tag in Model.Tags ?? [])
{
    if (tag.Status == TagStatus.Approved)
    {
        <a asp-page="./Index" asp-route-currentFilter="@tag.Name" class="@Model.CssClass bg-info">@tag.Name</a>
    }
    else
    {
        <span class="@Model.CssClass bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle" title="待審標籤"><i class="fas fa-hourglass-half" aria-hidden="true"></i> @tag.Name<span class="visually-hidden">（待審）</span></span>
    }
}
