@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
<!DOCTYPE html>
<html lang="zh-TW" data-bs-theme="auto">
<head>
    @{
        var currentPath = HttpContextAccessor.HttpContext.Request.Path.Value;
        bool showAdsOnToolPages = currentPath.StartsWith("/Functions");
    }

    @if (showAdsOnToolPages)
    {
        @await Component.InvokeAsync("UserStatus")
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Involver - @ViewData["Title"]</title>
    @* Import map 必須出現在任何 type="module" 腳本之前，對應表定義在 ImportMapHelper *@
    <script type="importmap" asp-importmap="@ImportMapHelper.Create(FileVersionProvider, Context.Request.PathBase)"></script>
    @* Vue 不再以全域 <script> 載入：元件以 import { createApp } from 'vue' 取得，只有用到 Vue 的頁面才會下載 *@

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <environment include="Development">
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    </environment>
    <environment include="Staging,Production">
        <link rel="stylesheet"
              href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
              asp-fallback-href="~/lib/bootstrap/css/bootstrap.min.css"
              asp-fallback-test-class="visually-hidden"
              asp-fallback-test-property="position"
              asp-fallback-test-value="absolute"
              integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />
    </environment>
    <link rel="stylesheet" href="~/lib/ckeditor5/dist/browser/ckeditor5-content.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/ckeditor5/dist/browser/ckeditor5-editor.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" integrity="sha512-KfkfwYDsLkIlwQp6LFnl8zNdLGxu9YAA1QvwINks4PhcElQSvqcyVLLD9aMhXd13uQjoXtEKNosOWaZqXgel0g==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
    <script src="~/js/color-mode-toggler.js" asp-append-version="true"></script>

    @RenderSection("Styles", required: false)
    @RenderSection("Head", required: false)
    <style>
        .video-container {
            position: relative;
            width: 100%;
            overflow: hidden;
            padding-top: 56.25%;
        }

        .responsive-iframe {
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            right: 0;
            width: 100%;
            height: 100%;
            border: none;
        }

        #gotop, #gobottom {
            position: fixed;
            z-index: 90;
            right: 30px;
            width: 50px;
            height: 50px;
            color: var(--md-on-primary-fill);
            background-color: var(--md-primary-fill);
            line-height: 50px;
            border-radius: 50%;
            text-align: center;
            box-shadow: 0 2px 10px 0 rgba(0,0,0,0.15);
            opacity: 0;
            transform: scale(0.9);
            transition: opacity 0.3s ease-in-out, transform 0.3s ease-in-out, background-color 0.3s;
            pointer-events: none; /* Initially not clickable */
        }

        #gotop {
            bottom: calc(91px + var(--bottom-nav-offset, 0px));
        }

        #gobottom {
            bottom: calc(31px + var(--bottom-nav-offset, 0px));
        }

            #gotop.visible, #gobottom.visible {
                opacity: 0.8;
                transform: scale(1);
                pointer-events: auto; /* Clickable when visible */
            }

            #gotop:hover, #gobottom:hover {
                background-color: color-mix(in oklab, var(--md-primary-fill), var(--md-on-primary-fill) 8%);
                opacity: 1;
                transform: scale(1.05) translateY(-3px);
            }
    </style>
</head>

@{
    string returnRightFunction = ViewData["ReturnRightFunction"] != null ? "false" : "true";
}

<body id="layout-body" oncontextmenu="return @returnRightFunction" onselectstart="return @returnRightFunction">
    <div class="text-center" style="position: absolute;top: 15rem;right: 50%;z-index:100;">
        <div id="loading" class="spinner-border text-warning" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Loading...</span>
        </div>
    </div>
    <a class="skip-link visually-hidden-focusable" href="#main-content">跳到主要內容</a>
    @await Component.InvokeAsync("AnnouncementBanner")
    <partial name="_SiteHeaderPartial" />
    <div id="modal"></div>
    <div aria-live="polite" aria-atomic="true" style="position: fixed; bottom: calc(30px + var(--bottom-nav-offset, 0px)); right: 30px; min-width: 300px; z-index: 1030;">
        <div id="toast-container" style="position: absolute; bottom: 0; right: 0;">
        </div>
    </div>
    @* 管理員後台、創作者中心需要較寬的版面，以 ViewData["ContainerClass"] 指定 *@
    <div class="@(ViewData["ContainerClass"] as string ?? "container") mb-4">
        <main role="main" id="main-content" class="pb-3" tabindex="-1">
            <partial name="_CookieConsentPartial" />
            @await Component.InvokeAsync("Breadcrumb")
            @RenderBody()
        </main>
    </div>
    <partial name="_SiteFooterPartial" />
    <partial name="_BottomNavPartial" />

    <environment include="Development">
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>
    </environment>
    <environment include="Staging,Production">
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
                asp-fallback-src="~/lib/bootstrap/js/bootstrap.bundle.min.js"
                asp-fallback-test="window.bootstrap"
                integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
                crossorigin="anonymous"></script>
    </environment>
    <script type="module" src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://www.google.com/recaptcha/api.js"></script>
    <script src="~/js/form-validation.js" asp-append-version="true"></script>

    @{
        if (TempData["Toasts"] is string toastsJson)
        {
            // Ensure the JSON is not empty or just "[]"
            if (!string.IsNullOrWhiteSpace(toastsJson) && toastsJson.Length > 2)
            {
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        try {
                            // The JSON comes from the server and is safe to be rendered raw.
                            // The receiving function `showGlobalToasts` will then build the safe HTML.
                            showGlobalToasts(@Html.Raw(toastsJson));
                        }
                        catch (e) {
                            console.error("Failed to show toasts from TempData:", e);
                        }
                    });
                </script>
            }
        }
    }

    <a href="#" id="gotop">
        <i class="fa fa-angle-up"></i>
    </a>
    <a href="#" id="gobottom">
        <i class="fa fa-angle-down"></i>
    </a>

    @RenderSection("Scripts", required: false)
    @Html.PageScripts()
</body>
</html>
