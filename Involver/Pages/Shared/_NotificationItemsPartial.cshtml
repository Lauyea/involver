@model Involver.Models.ViewModels.NotificationListViewModel

@*
    通知項目（M3 的 list item：頭像或種類圖示＋兩行文字＋時間）。
    導覽列下拉選單與通知頁共用；只輸出 <li>，外層的 <ul class="notification-list"> 由使用的頁面提供，
    讓通知頁的無限捲動可以直接把下一頁接在後面。
    點擊會先到 /Feed/Notifications?handler=Open，標為已讀後再轉到通知的頁面。
*@

@foreach (var item in Model.Items)
{
    <li class="notification-item @(item.IsRead ? null : "notification-item--unread")">
        <a class="notification-item__link @(Model.InMenu ? "dropdown-item" : null)"
           asp-area="" asp-page="/Feed/Notifications" asp-page-handler="Open" asp-route-id="@item.Id">
            <span class="notification-item__visual">
                @if (item.ActorImageUrl != null)
                {
                    <img class="notification-item__avatar" src="@item.ActorImageUrl" alt="" width="40" height="40" loading="lazy" />
                    <span class="notification-item__badge notification-item__badge--@item.Tone">
                        <i class="fa-solid @item.IconClass" aria-hidden="true"></i>
                    </span>
                }
                else
                {
                    <span class="notification-item__icon notification-item__icon--@item.Tone">
                        <i class="fa-solid @item.IconClass" aria-hidden="true"></i>
                    </span>
                }
            </span>
            <span class="notification-item__body">
                <span class="notification-item__text">
                    @if (item.ActorName != null)
                    {
                        <strong class="notification-item__actor">@item.ActorName</strong>
                    }
                    @Html.AntiXssRaw(item.Title)
                </span>
                @if (!string.IsNullOrEmpty(item.Excerpt))
                {
                    <span class="notification-item__excerpt">@item.Excerpt</span>
                }
                <time class="notification-item__time" datetime="@item.CreatedDate.ToString("s")" title="@item.CreatedDate.ToString("yyyy/MM/dd HH:mm")">@item.TimeAgo</time>
            </span>
            @if (!item.IsRead)
            {
                <span class="notification-item__dot" aria-hidden="true"></span>
                <span class="visually-hidden">（未讀）</span>
            }
        </a>
    </li>
}
